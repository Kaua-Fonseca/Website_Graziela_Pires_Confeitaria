# ---- Obrigatório ----
DATABASE_URL=postgres://usuario:senha@localhost:5432/graziela

# ---- Produção ----
# URL pública do site (usada no link do e-mail de redefinição de senha)
SITE_URL=https://seu-dominio.com.br
# true quando o app estiver atrás de proxy/CDN confiável (usa X-Forwarded-For para o IP)
TRUST_PROXY=false

# ---- E-mail (recuperação de senha). Sem SMTP_HOST, nenhum e-mail é enviado ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Graziela Pires Confeitaria <contato@seu-dominio.com.br>"

# ---- Opcional ----
# Pasta das imagens enviadas pelo painel (padrão: ./uploads). Faça backup dela junto com o banco.
UPLOAD_DIR=uploads
